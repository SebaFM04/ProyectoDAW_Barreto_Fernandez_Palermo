<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Refugio del Oeste</title>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <link href="Estilos/EstilosMaestro.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">

        <!-- ===== NAVBAR ===== -->
        <nav class="navbar">
            <div class="container">

                <div class="navbar-header">
                    <a class="navbar-brand" runat="server" href="~/MenuPrincipal.aspx">🐾 Refugio del Oeste
                    </a>

                    <button type="button" class="navbar-toggle" id="btnToggleMenu">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                </div>

                <div class="navbar-menu" id="navbarMenu">

                    <ul class="nav navbar-nav" runat="server" id="navMenu">

                        <li runat="server" id="liInicio">
                            <a runat="server" href="~/MenuPrincipal.aspx">Inicio</a>
                        </li>

                        <%-- Animales --%>
                        <li class="dropdown" runat="server" id="liAnimales">
                            <a href="#" class="dropdown-toggle">Animales</a>
                            <ul class="dropdown-menu">
                                <li runat="server" id="liVerAnimales"><a runat="server" href="~/ListadoAnimales.aspx">Ver animales</a></li>

                                <li runat="server" id="liRegistrarAnimales" data-pagina="RegistroAnimales.aspx">
                                    <a runat="server" href="~/RegistroAnimales.aspx">Registrar animales</a>
                                </li>
                                <li runat="server" id="liGestionVacunas" data-pagina="GestionIntermediaVacunaAnimal.aspx">
                                    <a runat="server" href="~/GestionIntermediaVacunaAnimal.aspx">Gestion Vacunas</a>
                                </li>
                            </ul>
                        </li>

                        <%-- Adopciones --%>
                        <li class="dropdown" runat="server" id="liAdopciones">
                            <a href="#" class="dropdown-toggle">Adopciones</a>
                            <ul class="dropdown-menu">
                                <li runat="server" data-pagina="Solicitudes.aspx"><a runat="server" href="~/Solicitudes.aspx">Solicitudes</a></li>
                                <li runat="server" data-pagina="Certificados.aspx"><a runat="server" href="~/Certificados.aspx">Certificados</a></li>
                                <li runat="server" data-pagina="Adoptantes.aspx"><a runat="server" href="~/Adoptantes.aspx">Adoptantes</a></li>
                            </ul>
                        </li>

                        <!-- Administración -->
                        <li class="dropdown" runat="server" id="liAdministracion">
                            <a href="#" class="dropdown-toggle">Administración</a>
                            <ul class="dropdown-menu">
                                <li runat="server" data-pagina="GestionUsuarios.aspx"><a runat="server" href="~/GestionUsuarios.aspx">Usuarios</a></li>
                                <li runat="server" data-pagina="RolesFamilias.aspx"><a runat="server" href="~/RolesFamilias.aspx">Roles y Familias</a></li>
                                <li runat="server" id="liBitacora" data-pagina="Bitacora.aspx">
                                    <asp:LinkButton ID="btnBitacora" runat="server" OnClick="btnBitacora_Click">Bitácora</asp:LinkButton>
                                </li>
                                <li class="divider"></li>
                                <li runat="server" id="liBackupRestore" data-pagina="BackupRestore.aspx">
                                    <asp:LinkButton 
                                    runat="server" href="BackupRestore.aspx" OnClick="btnBackupRestore_Click">Backup &amp; Restore
                                        </asp:LinkButton>
                                </li>
                            </ul>
                        </li>

                        <!-- Login / Logout -->
                        <li runat="server" id="liLogin">
                            <a runat="server" href="~/Login.aspx">Iniciar Sesión</a>
                        </li>

                        <li runat="server" id="liLogout">
                            <asp:LinkButton ID="btnCerrarSesion" runat="server" OnClick="btnCerrarSesion_Click">Cerrar Sesión</asp:LinkButton>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>

        <!-- CONTENIDO -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

        <!-- FOOTER -->
        <footer id="footer">
            <span>contacto@refugio.com</span>
            <span>Whatsapp +54 11 1111 1111</span>
            <span>www.refugioDAW.com</span>
        </footer>

    </form>

    <!-- JS -->
    <script src="Scripts/ScriptMaster.js"></script>
    
</body>
</html>
